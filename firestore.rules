rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────
    // Admins can list all users; regular users can only access their own doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Managers (dashboard admin login + management) ──────
    match /managers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Categories ─────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Bank Rates / Profit Margins ───────────────────────
    // profit_margins يُقرأ عاماً: صفحة هوامش الربح (hawawem-arbach) تعمل
    // داخل WebView التطبيق بدون جلسة Firebase Auth.
    match /bank_rates/{docId} {
      allow read: if docId == 'profit_margins' || request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Bank Margins Scraper (صفحات bank-margins / margins-compare العامة) ──
    // القراءة عامة لأن الصفحات تعمل بدون مصادقة؛ الكتابة من Cloud Functions
    // (Admin SDK يتجاوز القواعد) أو من الداشبورد بمصادقة.
    match /bank_margins/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /grok_margins/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /scraper_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── App Notifications ─────────────────────────────────
    match /app_notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /acknowledgments/{ackId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── AI Config ─────────────────────────────────────────
    match /ai_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── AI Conversations ──────────────────────────────────
    match /ai_conversations/{convId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── App Config / Pages ────────────────────────────────
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Tools ─────────────────────────────────────────────
    match /tools/{toolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Stats (web visits / logins counter) ──────────────
    match /stats/web {
      allow read: if request.auth != null;
      allow write: if request.resource.data.keys().hasOnly(['visitCount', 'loginCount']);
    }

    // ════════════════════════════════════════════════════════
    // ▼▼▼  إضافات المرحلة 0 — البنية الديناميكية الجديدة  ▼▼▼
    // القاعدة العامة: كل ما يقرؤه التطبيق/الموقع بلا تسجيل دخول = قراءة عامة،
    // والكتابة للأدمن فقط (نفس نمط profit_margins / bank_margins القائم).
    // ════════════════════════════════════════════════════════

    // ── Public Config (هيدر إعلاني / وضع الصيانة / SEO) ────
    // يُقرأ من التطبيق والموقع بلا مصادقة ليظهر فورًا؛ الكتابة من الداشبورد.
    // docs المتوقعة: 'header', 'maintenance', 'seo'
    match /public_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Site Content (محتوى الموقع/Landing Page القابل للتحرير) ──
    // docs المتوقعة: 'landing' (وأي صفحات ويب أخرى لاحقًا)
    match /site_content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Packages (باقات الاشتراك — الهيكل فقط، دون تنفيذ دفع) ──
    // قراءة عامة لعرض الأسعار في التطبيق/الموقع؛ الكتابة للأدمن.
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Audit Log (سجل العمليات — من/متى/ماذا غيّر) ────────
    // سجل غير قابل للتعديل: إنشاء فقط من الأدمن، ولا تعديل/حذف.
    match /audit_log/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
