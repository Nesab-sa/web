rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: هل المستخدم الحالي مدير؟ (له مستند في managers) ──
    // إنشاء أول مدير عبر Admin SDK / Cloud Function (createAdmin) الذي يتجاوز
    // القواعد؛ فلا يستطيع مستخدم عادي ترقية نفسه.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/managers/$(request.auth.uid));
    }

    // ── Users ──────────────────────────────────────────────
    // الأدمن يسرد الجميع؛ المستخدم العادي يقرأ مستنده فقط ويكتبه فقط.
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Managers (dashboard admin login + management) ──────
    // القراءة لأي مسجّل (فحص وجود الحساب عند تسجيل الدخول)، والكتابة للأدمن
    // القائم فقط — يُنشأ المدير الجديد عبر Cloud Function بـ Admin SDK.
    match /managers/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Categories ─────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Bank Rates / Profit Margins ───────────────────────
    // profit_margins يُقرأ عاماً: صفحة هوامش الربح (hawawem-arbach) تعمل
    // داخل WebView التطبيق بدون جلسة Firebase Auth.
    match /bank_rates/{docId} {
      allow read: if docId == 'profit_margins' || request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Bank Margins Scraper (صفحات bank-margins / margins-compare العامة) ──
    // القراءة عامة لأن الصفحات تعمل بدون مصادقة؛ الكتابة من Cloud Functions
    // (Admin SDK يتجاوز القواعد) أو من الداشبورد بمصادقة.
    match /bank_margins/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /grok_margins/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /scraper_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── App Notifications ─────────────────────────────────
    match /app_notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /acknowledgments/{ackId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── AI Config ─────────────────────────────────────────
    match /ai_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── AI Conversations ──────────────────────────────────
    match /ai_conversations/{convId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── App Config / Pages ────────────────────────────────
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Tools ─────────────────────────────────────────────
    match /tools/{toolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Stats (web visits / logins counter) ──────────────
    match /stats/web {
      allow read: if request.auth != null;
      allow write: if request.resource.data.keys().hasOnly(['visitCount', 'loginCount']);
    }

    // ── Stats (AI tokens/requests — تكتبها Cloud Functions فقط) ──
    match /stats/ai {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK يتجاوز القواعد
    }

    // ── Payments (سجل مدفوعات مستقبلي — قراءة للأدمن، كتابة عبر Functions) ──
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK يتجاوز القواعد
    }

    // ── إحصاءات التطبيق: نشاط المستخدمين وعدّادات زيارات الصفحات ──────
    // تُكتب من صفحات المنتجات (HTML) داخل التطبيق، وهي صفحات عامة بلا
    // مصادقة — لذا الكتابة مسموحة لكن مقيّدة بأسماء الحقول فقط (نفس نمط
    // stats/web أعلاه)، والقراءة محصورة بالداشبورد (مستخدم مسجّل).
    // product_activity: مستند لكل زائر يحمل آخر فتح (lastOpenAt).
    match /product_activity/{visitorId} {
      allow read: if request.auth != null;
      allow write: if request.resource.data.keys().hasOnly(['lastOpenAt']);
    }
    // product_stats: عدّاد زيارات لكل صفحة/منتج.
    match /product_stats/{pageId} {
      allow read: if request.auth != null;
      allow write: if request.resource.data.keys()
                     .hasOnly(['views', 'nameAr', 'nameEn', 'lastOpenAt']);
    }

    // ════════════════════════════════════════════════════════
    // ▼▼▼  إضافات المرحلة 0 — البنية الديناميكية الجديدة  ▼▼▼
    // القاعدة العامة: كل ما يقرؤه التطبيق/الموقع بلا تسجيل دخول = قراءة عامة،
    // والكتابة للأدمن فقط (نفس نمط profit_margins / bank_margins القائم).
    // ════════════════════════════════════════════════════════

    // ── Public Config (هيدر إعلاني / وضع الصيانة / SEO) ────
    // يُقرأ من التطبيق والموقع بلا مصادقة ليظهر فورًا؛ الكتابة من الداشبورد.
    // docs المتوقعة: 'header', 'maintenance', 'seo'
    match /public_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Site Content (محتوى الموقع/Landing Page القابل للتحرير) ──
    // docs المتوقعة: 'landing' (وأي صفحات ويب أخرى لاحقًا)
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Packages (باقات الاشتراك — الهيكل فقط، دون تنفيذ دفع) ──
    // قراءة عامة لعرض الأسعار في التطبيق/الموقع؛ الكتابة للأدمن.
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Audit Log (سجل العمليات — من/متى/ماذا غيّر) ────────
    // قراءة وإنشاء للأدمن فقط، ولا تعديل/حذف إطلاقاً (سجل غير قابل للتلاعب).
    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
